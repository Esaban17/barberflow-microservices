# ─────────────────────────────────────────────────────────────
# BarberFlow — copiar a .env y completar. NUNCA commitear .env
# ─────────────────────────────────────────────────────────────

# JWT (compartido por los servicios que emiten/validan tokens)
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRE_MINUTES=60

# users-db
USERS_DB_NAME=users_db
USERS_DB_SUPERUSER=users_admin
USERS_DB_SUPERPASSWORD=cambiar
USERS_APP_USER=users_app
USERS_APP_PASSWORD=cambiar

# booking-db
BOOKING_DB_NAME=booking_db
BOOKING_DB_SUPERUSER=booking_admin
BOOKING_DB_SUPERPASSWORD=cambiar
BOOKING_APP_USER=booking_app
BOOKING_APP_PASSWORD=cambiar

# notif-db
NOTIF_DB_NAME=notif_db
NOTIF_DB_SUPERUSER=notif_admin
NOTIF_DB_SUPERPASSWORD=cambiar
NOTIF_APP_USER=notif_app
NOTIF_APP_PASSWORD=cambiar

# Usuario demo que usa el MCP Server para autenticarse contra users-svc
DEMO_USER_EMAIL=demo@barberflow.local
DEMO_USER_PASSWORD=cambiar

# Agentes A2A (opcional: sin key, el orquestador cae a parser por keywords)
ANTHROPIC_API_KEY=

# Puertos publicados en el host (los internos son fijos: ver README)
BOOKING_PORT=8001
NOTIF_PORT=8002
USERS_PORT=8003
MCP_PORT=8000
CONSUL_PORT=8500
ORCHESTRATOR_PORT=9000
BOOKING_AGENT_PORT=9001
NOTIFICATION_AGENT_PORT=9002
WEB_PORT=3080

# Solo si tu red intercepta TLS (proxy corporativo tipo Zscaler) y `pip install`
# falla con CERTIFICATE_VERIFY_FAILED al construir las imágenes. Vacío = build normal.
# PIP_TRUSTED_HOST=pypi.org files.pythonhosted.org
